# Copie este arquivo para ".env" e preencha os valores antes de rodar.
# .env não é versionado (veja .gitignore).

# Ambiente alvo: "preprod" ou "prod" (ver ENVIRONMENTS em src/config/environments.ts)
SITE_SPORTSBOOK_ENV=preprod

# Token de autenticação (Bearer) — só necessário se você NÃO for usar
# "npm run login" (recomendado — não deixa senha em disco)
SITE_SPORTSBOOK_AUTH_TOKEN=

# Último recurso: login automático com usuário/senha em texto puro no .env.
# Prefira "npm run login" — ele pede a senha na hora e nunca a grava.
SITE_SPORTSBOOK_USERNAME=
SITE_SPORTSBOOK_PASSWORD=

# Quantas apostas gerar no total
SITE_SPORTSBOOK_TOTAL_BETS=10

# Tamanho de cada lote (a execução escalona lote a lote)
SITE_SPORTSBOOK_BATCH_SIZE=10

# Quantas requisições simultâneas no máximo
SITE_SPORTSBOOK_CONCURRENCY=5

# Taxa de erro (0-1) que, se ultrapassada em um lote, aborta o teste
SITE_SPORTSBOOK_ERROR_THRESHOLD=0.02

# Se definido, TODAS as apostas geradas usam esse valor fixo em vez de
# sortear dentro da faixa configurada em marketsWeights.json
SITE_SPORTSBOOK_BET_AMOUNT=0.5

# Se informado, garante que TODA categoria ativa (peso > 0 em
# marketsWeights.json) apareça pelo menos essa quantidade de vezes no
# volume total — essencial para volumes pequenos (ex: 20 apostas), onde
# sorteio 100% aleatório pode nunca cobrir categorias de peso baixo.
# Deixe vazio para manter o sorteio aleatório original (melhor para
# volumes grandes, tipo 50.000).
SITE_SPORTSBOOK_MIN_PER_CATEGORY=2

# Caminhos alternativos dos pools de dados (opcional — defaults já apontam
# para fixtures.prod.json / liveFixtures.prod.json / seasonMarkets.sample.json
# no diretório do projeto)
# SITE_SPORTSBOOK_FIXTURES_PATH=./fixtures.prod.json
# SITE_SPORTSBOOK_LIVE_FIXTURES_PATH=./liveFixtures.prod.json
# SITE_SPORTSBOOK_SEASON_MARKETS_PATH=./seasonMarkets.sample.json
