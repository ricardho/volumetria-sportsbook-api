{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Assistente (wizard) — configurar e rodar tudo",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "src/cli/wizard.ts"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Rodar teste de volumetria (modo legado, uma sessão)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "src/cli/runVolumetry.ts"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Buscar fixtures reais (fetchFixtures)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "src/cli/fetchFixtures.ts"],
      "args": [],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Construir pool a partir de raw-fixtures/",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "src/cli/buildFixturePool.ts", "./data/raw-fixtures"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
